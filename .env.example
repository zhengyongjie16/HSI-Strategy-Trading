# ===========================================
# HSI趋势延续验证环境变量配置示例
# ===========================================
# 复制此文件为 .env.local 并填入实际配置值
# ===========================================

# ===========================================
# Longbridge 认证配置（必需）
# ===========================================
# 认证模式：oauth 使用浏览器授权；apikey 使用三元组直连
LONGBRIDGE_AUTH_MODE=oauth

# ---------- OAuth 模式 ----------
# OAuth 客户端 ID：从 Longbridge 开放平台创建 OAuth Client 后获取
LONGBRIDGE_CLIENT_ID=demo_client_id

# OAuth 回调端口：需与开放平台登记的 redirect URI 端口一致
LONGBRIDGE_CALLBACK_PORT=60355

# ---------- API Key 模式 ----------
# LONGBRIDGE_APP_KEY=your_longbridge_app_key
# LONGBRIDGE_APP_SECRET=your_longbridge_app_secret
# LONGBRIDGE_ACCESS_TOKEN=your_longbridge_access_token

# SDK HTTP 地址：通常保持官方默认即可
LONGBRIDGE_HTTP_URL=https://openapi.longbridge.cn
# 行情 WebSocket 地址：用于订阅报价与 K 线推送
LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.cn/v2
# 交易 WebSocket 地址：用于交易链路推送
LONGBRIDGE_TRADE_WS_URL=wss://openapi-trade.longbridge.cn/v2
# SDK 语言：仅支持 zh-CN / zh-HK / en
LONGBRIDGE_LANGUAGE=en
# 是否启用夜盘支持：按券商与账户能力决定
LONGBRIDGE_ENABLE_OVERNIGHT=false
# K 线推送模式：realtime 为实时推送，confirmed 为仅推送确认 K 线
LONGBRIDGE_PUSH_CANDLESTICK_MODE=realtime
# 是否在启动时打印行情权限包信息
LONGBRIDGE_PRINT_QUOTE_PACKAGES=true
# SDK 日志目录：用于写入 Longbridge SDK 自身日志
LONGBRIDGE_LOG_PATH=logs/sdk

# ===========================================
# 全局配置
# ===========================================
# 调试模式：true 时输出更多调试日志
DEBUG=true

# 末日保护：收盘前拒绝新买入，并在更晚时点自动清仓
DOOMSDAY_PROTECTION=true

# 是否启用早盘开盘保护：09:30 起暂停信号生成
MORNING_OPENING_PROTECTION_ENABLED=true
# 早盘开盘保护时长：单位分钟，启用时必填
MORNING_OPENING_PROTECTION_MINUTES=15

# 是否启用午盘开盘保护：13:00 起暂停信号生成
AFTERNOON_OPENING_PROTECTION_ENABLED=true
# 午盘开盘保护时长：单位分钟，启用时必填
AFTERNOON_OPENING_PROTECTION_MINUTES=5

# 是否启用买入订单超时处理
BUY_ORDER_TIMEOUT_ENABLED=true
# 买入订单超时秒数：超时后进入买单超时处理流程
BUY_ORDER_TIMEOUT_SECONDS=180

# 是否启用卖出订单超时处理
SELL_ORDER_TIMEOUT_ENABLED=false
# 卖出订单超时秒数：超时后进入卖单超时处理流程
SELL_ORDER_TIMEOUT_SECONDS=180

# 订单监控改价间隔：单位秒，控制追价频率
ORDER_MONITOR_PRICE_UPDATE_INTERVAL=3

# 买单追价是否允许突破初始委托价继续上调
ALLOW_BUY_ORDER_TRACKING_ABOVE_INITIAL_PRICE=false

# 正常交易订单类型：用于常规买卖单
TRADING_ORDER_TYPE=ELO

# 保护性清仓订单类型：用于最大浮亏等清仓场景
LIQUIDATION_ORDER_TYPE=ELO

# ===========================================
# 策略配置
# ===========================================
# 席位模式：static 为固定标的；auto 为运行时自动寻标
SEAT_MODE=auto

# ---------- 静态席位模式 ----------
# 做多标的代码：静态模式下的 long 执行标的，格式为 ticker.region
# LONG_SYMBOL=55399.HK
# 做空标的代码：静态模式下的 short 执行标的，格式为 ticker.region
# SHORT_SYMBOL=55398.HK

# ---------- 自动寻标模式 ----------
# 自动席位模式：启用后 LONG_SYMBOL / SHORT_SYMBOL 不再使用
# 订单归属映射：从 stockName 中识别本策略订单归属的别名列表
ORDER_OWNERSHIP_MAPPING=HSI
# 牛证最低寻标距离：候选牛证距回收价至少达到该百分比
AUTO_SEARCH_MIN_DISTANCE_PCT_BULL=1.8
# 熊证最低寻标距离：候选熊证距回收价至少达到该百分比
AUTO_SEARCH_MIN_DISTANCE_PCT_BEAR=-1.8
# 牛证最低分均成交额：低于该值的候选牛证会被过滤
AUTO_SEARCH_MIN_TURNOVER_PER_MINUTE_BULL=300000
# 熊证最低分均成交额：低于该值的候选熊证会被过滤
AUTO_SEARCH_MIN_TURNOVER_PER_MINUTE_BEAR=300000
# 最低剩余到期月数：过滤临近到期的候选标的
AUTO_SEARCH_EXPIRY_MIN_MONTHS=12
# 自动寻标开盘延迟：早盘开盘后等待多少分钟再开始寻标
AUTO_SEARCH_OPEN_DELAY_MINUTES=5
# 周期换标间隔：单位分钟，0 表示关闭周期换标
SWITCH_INTERVAL_MINUTES=60
# 牛证距离换标区间：距回收价落入该 min,max 区间时触发换标检查
SWITCH_DISTANCE_RANGE_BULL=0.6,3.5
# 熊证距离换标区间：距回收价落入该 min,max 区间时触发换标检查
SWITCH_DISTANCE_RANGE_BEAR=-3.5,-0.6

# 单次目标交易金额：用于计算每次下单目标仓位
TARGET_NOTIONAL=10000
# 最大持仓市值：限制单方向执行标的的总持仓规模
MAX_POSITION_NOTIONAL=100000
# 最大浮亏：达到后触发保护性清仓
MAX_UNREALIZED_LOSS=2200
# 买入间隔：两次买入之间的最小间隔秒数
BUY_INTERVAL_SECONDS=60

# 清仓后买入冷却：支持分钟数、half-day、one-day
LIQUIDATION_COOLDOWN=half-day
# 触发冷却所需的保护性清仓次数上限
LIQUIDATION_TRIGGER_LIMIT=2

# ATR 短周期：用于波动率扩张对比的短窗口
REGIME_THRESHOLDS_ATR_SHORT_PERIOD=5
# ATR 长周期：用于波动率扩张对比的长窗口
REGIME_THRESHOLDS_ATR_LONG_PERIOD=30
# 波动率分位窗口：按最近多少个交易日统计同 session 波动率分位
REGIME_THRESHOLDS_RV_QUANTILE_WINDOW_DAYS=20
# 趋势开启波动扩张阈值：超过该倍数视为趋势波动放大
REGIME_THRESHOLDS_TREND_ON_VOL_EXPANSION=1.2
# 趋势关闭波动扩张阈值：低于该倍数视为趋势波动不足
REGIME_THRESHOLDS_TREND_OFF_VOL_EXPANSION=0.9
# 极端波动扩张阈值：超过后视为极端波动环境
REGIME_THRESHOLDS_EXTREME_VOL_EXPANSION=1.8
# 趋势开启波动分位阈值：超过该分位才允许趋势环境成立
REGIME_THRESHOLDS_TREND_ON_VOL_QUANTILE=0.7
# 趋势关闭波动分位阈值：低于该分位视为趋势环境关闭
REGIME_THRESHOLDS_TREND_OFF_VOL_QUANTILE=0.4
# 极端波动分位阈值：超过后视为极端波动环境
REGIME_THRESHOLDS_EXTREME_VOL_QUANTILE=0.95

# 15 分钟趋势评分权重：参与总趋势分数合成
TREND_SCORE_THRESHOLDS_W15=0.25
# 30 分钟趋势评分权重：参与总趋势分数合成
TREND_SCORE_THRESHOLDS_W30=0.35
# 60 分钟趋势评分权重：参与总趋势分数合成
TREND_SCORE_THRESHOLDS_W60=0.4
# 趋势分类阈值：达到后才被归类为有效趋势
TREND_SCORE_THRESHOLDS_CLASSIFICATION_THRESHOLD=0.8
# 开仓阈值：达到后才允许按趋势方向开仓
TREND_SCORE_THRESHOLDS_ENTRY_THRESHOLD=0.9
# 退出阈值：低于该值视为趋势衰减
TREND_SCORE_THRESHOLDS_EXIT_THRESHOLD=0.35
# 反向失效阈值：反向趋势分数达到该值时立即判定失效
TREND_SCORE_THRESHOLDS_REVERSE_INVALIDATION_THRESHOLD=0.5

# ER15 开仓下限：15 分钟效率低于该值不允许开仓
ER_THRESHOLDS_ER15_ENTRY_MIN=0.4
# ER30 开仓下限：30 分钟效率低于该值不允许开仓
ER_THRESHOLDS_ER30_ENTRY_MIN=0.35
# ER15 退出上限：15 分钟效率低于该值触发退出
ER_THRESHOLDS_ER15_EXIT_MAX=0.25
# ER30 退出上限：30 分钟效率低于该值触发退出
ER_THRESHOLDS_ER30_EXIT_MAX=0.2
# 强趋势效率下限：用于识别更强的趋势推进
ER_THRESHOLDS_STRONG_TREND_ER_FLOOR=0.45

# VWAP 距离带：价格距 VWAP 在该 ATR 带宽内视为贴近
VWAP_CONFIRM_RULES_DISTANCE_BAND_ATR=0.1
# VWAP 斜率窗口：用多少根 1m bar 估算 VWAP 方向
VWAP_CONFIRM_RULES_SLOPE_WINDOW_BARS=5
# 最近 10 分钟最大穿越次数：超过则视为围绕 VWAP 震荡过多
VWAP_CONFIRM_RULES_MAX_CROSS_COUNT_LAST10M=2

# 开盘区间窗口：用前多少分钟定义 opening range
OPENING_STRUCTURE_RULES_OR_WINDOW_MINUTES=20
# 早盘噪音窗口：该时段内抑制早盘噪音影响
OPENING_STRUCTURE_RULES_MORNING_NOISE_WINDOW_MINUTES=20
# 午盘噪音窗口：该时段内抑制午盘重开噪音影响
OPENING_STRUCTURE_RULES_AFTERNOON_NOISE_WINDOW_MINUTES=15
# 突破评分下限：低于该值不认定为有效突破
OPENING_STRUCTURE_RULES_BREAKOUT_SCORE_MIN=0.8
# 区间外持续观察窗口：突破后观察多少根 1m bar
OPENING_STRUCTURE_RULES_OUTSIDE_PERSISTENCE_WINDOW_BARS=5
# 区间外停留比例下限：观察窗口内至少多少比例需保持在区间外
OPENING_STRUCTURE_RULES_OUTSIDE_PERSISTENCE_MIN=0.6
# 回踩容忍 ATR：允许突破后回踩的最大 ATR 倍数
OPENING_STRUCTURE_RULES_RETEST_TOLERANCE_ATR=0.2
# 突破确认 bar 数：要求连续多少根同向 bar 完成确认
OPENING_STRUCTURE_RULES_CONFIRM_BARS=2

# 上午推进 z 分数下限：上午走势强度至少达到该标准
PM_CONTINUATION_RULES_AM_MOVE_Z_MIN=0.8
# 午休保持比例下限：午盘重开后至少保留上午推进的比例
PM_CONTINUATION_RULES_MIDDAY_HOLD_MIN=0.6
# 午后再扩张趋势评分下限：用于确认午后延续
PM_CONTINUATION_RULES_PM_RE_EXPANSION_TREND_SCORE_MIN=0.9
# 午后再扩张 ER15 下限：用于确认午后延续
PM_CONTINUATION_RULES_PM_RE_EXPANSION_ER15_MIN=0.35
# 午后延续最早确认时间：达到该时间后才允许确认 PM continuation
PM_CONTINUATION_RULES_PM_CONFIRM_CUTOFF_TIME=13:30

# 牛证最小安全距离：低于该距回收价百分比拒绝买入
INSTRUMENT_ADAPTATION_RULES_BULL_BUY_MIN_DISTANCE_PCT=0.35
# 熊证最大安全距离：高于该距回收价百分比拒绝买入
INSTRUMENT_ADAPTATION_RULES_BEAR_BUY_MAX_DISTANCE_PCT=-0.35
# 牛证清仓距离：低于该距回收价百分比触发保护清仓
INSTRUMENT_ADAPTATION_RULES_BULL_LIQUIDATION_DISTANCE_PCT=0.2
# 熊证清仓距离：高于该距回收价百分比触发保护清仓
INSTRUMENT_ADAPTATION_RULES_BEAR_LIQUIDATION_DISTANCE_PCT=-0.2
