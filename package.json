{
  "name": "longbridge-option-quant",
  "version": "16.8.0",
  "description": "基于 Longbridge OpenAPI 的港股双向自动化交易系统（TypeScript）",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "start": "bun src/index.ts",
    "type-check": "bun check -p tsconfig.json",
    "test": "bun --no-env-file test",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "bun fmt && bun fmt --parser=json-stringify bun.lock"
  },
  "dependencies": {
    "bignumber.js": "9.3.1",
    "longbridge": "5.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.4",
    "eslint": "10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.65.0"
  }
}